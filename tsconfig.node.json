{
  // Ferramentas em Node (tsx) e configuração do Vite. O DSP de src/ também é verificado aqui,
  // porque ele precisa rodar no Node sem nada do navegador.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  // Todo o DSP de src/engines/ entra por inteiro (antes eram as famílias uma a uma, e Radial, Rotativos e Vapor só eram
  // verificados pelo que tools/ importava: um arquivo que nenhuma ferramenta usasse saía da verificação sem aviso).
  // Os processadores do worklet (src/worklet/processador-*.ts, registrar.ts) ficam de fora: dependem dos globais do
  // AudioWorklet, que o tsconfig.json do navegador declara.
  "include": ["tools/**/*.ts", "vite.config.mts", "src/acoustics/**/*.ts", "src/engines/**/*.ts", "src/scene/**/*.ts", "src/carriers/**/*.ts", "src/worklet/tom.ts", "src/worklet/tipos.ts"]
}
