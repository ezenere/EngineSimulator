{
  "name": "engine",
  "private": true,
  "version": "0.0.0",
  "description": "Ronco, Turbina, Diesel, Radial, Rotativos, Elétrico e Vapor: síntese física de som de motores no navegador",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "verificar": "node tools/verificar.mjs",
    "verificar:rapido": "node tools/verificar.mjs --rapido",
    "auditoria:fichas": "tsx tools/auditoria-fichas.ts",
    "auditoria:som": "tsx tools/auditoria-som.ts",
    "render": "tsx tools/render.ts",
    "compare-wav": "tsx tools/compare-wav.ts",
    "paridade:ronco": "tsx tools/ronco-paridade.ts",
    "paridade:turbina": "tsx tools/turbina-paridade.ts",
    "paridade:acoustics": "tsx tools/acoustics-paridade.ts",
    "lenta:ronco": "tsx tools/ronco-lenta.ts",
    "navegador:ronco": "node tools/servir-dist.mjs node tools/ronco-navegador.mjs {url}/ronco.html",
    "navegador:turbina": "node tools/servir-dist.mjs node tools/turbina-testa-navegador.mjs {url}/turbina.html",
    "navegador:passagem": "node tools/passagem-navegador.mjs",
    "teste:cena": "tsx tools/cena/valida.ts",
    "teste:ouvinte": "tsx tools/cena/ouvinte-movel.ts",
    "cpu:cena": "tsx tools/cena/cpu.ts",
    "teste:passagem": "tsx tools/passagem-presets.ts",
    "teste:diesel": "tsx tools/diesel-valida.ts",
    "lenta:diesel": "tsx tools/diesel-lenta.ts",
    "governador:diesel": "tsx tools/diesel-governador.ts",
    "troca:diesel": "tsx tools/troca.ts diesel",
    "troca:ronco": "tsx tools/troca.ts ronco",
    "troca:radial": "tsx tools/troca.ts radial",
    "troca:rotativo": "tsx tools/troca.ts rotativo",
    "navegador:diesel": "node tools/diesel-navegador.mjs",
    "teste:radial": "tsx tools/radial-valida.ts",
    "lenta:radial": "tsx tools/radial-lenta.ts",
    "geometria:radial": "tsx tools/radial-geometria.ts",
    "cpu:radial": "tsx tools/radial-cpu.ts",
    "navegador:radial": "node tools/radial-navegador.mjs",
    "teste:rotativo": "tsx tools/rotativo-valida.ts",
    "lenta:rotativo": "tsx tools/rotativo-lenta.ts",
    "cpu:rotativo": "tsx tools/rotativo-cpu.ts",
    "navegador:rotativo": "node tools/rotativo-navegador.mjs",
    "teste:eletrico": "tsx tools/eletrico/valida.ts",
    "lenta:eletrico": "tsx tools/eletrico/lenta.ts",
    "cpu:eletrico": "tsx tools/eletrico/cpu.ts",
    "navegador:eletrico": "node tools/eletrico-navegador.mjs",
    "teste:vapor": "tsx tools/vapor-valida.ts",
    "lenta:vapor": "tsx tools/vapor-lenta.ts",
    "cpu:vapor": "tsx tools/vapor-cpu.ts",
    "gravacoes:vapor": "tsx tools/vapor-gravacoes.ts",
    "navegador:vapor": "node tools/vapor-navegador.mjs",
    "ouvido:teste": "python3 -I tools/ouvido/autoteste.py"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
